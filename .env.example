# Identity service
JWT_SECRET=development-only-resourcehive-secret-change-before-production
PORT=3001

# Pooled PostgreSQL connection used by backend services.
DATABASE_URL=postgresql://username:password@host:port/database

# Direct PostgreSQL connection used by Prisma migrations.
DATABASE_URL_UNPOOLED=postgresql://username:password@host:port/database

# Neon: use the "-pooler" endpoint for DATABASE_URL and the direct endpoint
# for DATABASE_URL_UNPOOLED. Remove channel_binding=require.
# Runtime parameters: ?sslmode=require&connect_timeout=30&pool_timeout=30
# Migration parameters: ?sslmode=require&connect_timeout=30

CORS_ORIGINS=http://localhost:3000
