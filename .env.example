# Local Docker services
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=resourcehive

# Identity service
JWT_SECRET=change_me
PORT=3001

# PostgreSQL connection used by Prisma and all backend services.
# Change only this URL to switch between PostgreSQL providers.
DATABASE_URL=postgresql://username:password@host:port/database
# Neon with Prisma 5.22: use the direct endpoint with
# ?sslmode=require&connect_timeout=30 and remove channel_binding=require.

REDIS_URL=redis://redis:6379
CORS_ORIGINS=http://localhost:3000

# Authentication-only configuration used by the existing auth implementation.
# Supabase is not used as the database or migration provider.
SUPABASE_URL=
SUPABASE_ANON_KEY=
