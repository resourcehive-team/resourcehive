# Identity service
JWT_SECRET=development-only-resourcehive-secret-change-before-production
PORT=3001
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=
BCRYPT_ROUNDS=12
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=24h
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h
EMAIL_TRANSPORT=console
EMAIL_FROM=ResourceHive <no-reply@resourcehive.local>

# Required only when EMAIL_TRANSPORT=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Resource Service
RESOURCE_SERVICE_PORT=3004


# Remove channel_binding=require from both URLs.
DATABASE_URL="postgresql://neondb_owner:password@ep-still-snow-asa-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-still-snow-asa.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
