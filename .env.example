# Copy this file to .env and fill in real values from the shared password manager entry.
# NEVER commit .env — it's already in .gitignore.

# --- Used by app services (NestJS) at runtime ---
DATABASE_URL=postgresql://app_user_role:REPLACE_ME@resourcehive-instance.xxxx.rds.amazonaws.com:5432/resourcehive

# --- Used ONLY by scripts/migrate.sh for schema changes (DDL) ---
# This is the RDS master/owner user. Never put this in app service config.
POSTGRES_OWNER_URL=postgresql://postgres:REPLACE_ME@resourcehive-instance.xxxx.rds.amazonaws.com:5432/resourcehive

