# Local API gateway
API_PORT=8000 # Windows Port
API_DOMAIN=http://localhost:8000 # Caddy's internal container Port
ACME_EMAIL=admin@localhost

# Neon/PostgreSQL. Use the pooled URL at runtime and the direct URL for Prisma migrations.
DATABASE_URL="postgresql://user:password@pooled-host:5432/resourcehive?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@direct-host:5432/resourcehive?sslmode=require"

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false

# Browser and email links
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=24h
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# Email. SMTP fields are only required when EMAIL_TRANSPORT=smtp.
EMAIL_TRANSPORT=console
EMAIL_FROM=ResourceHive <no-reply@resourcehive.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
