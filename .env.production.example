# Image tag deployed by GitHub Actions. The workflow overrides this with a commit SHA.
IMAGE_TAG=main

# Caddy obtains and renews HTTPS for this hostname automatically.
API_DOMAIN=api.resourcehive.thisismalindu.com
ACME_EMAIL=admin@thisismalindu.com

# Neon direct owner URL is used only for migrations, one-time role setup, and seeding.
# Runtime URLs must use these four dedicated login roles. Set unique passwords in
# the Neon console/SQL owner connection and use the matching URL per service.
DATABASE_URL="postgresql://user:password@pooled-host:5432/resourcehive?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@direct-host:5432/resourcehive?sslmode=require"
APP_DATABASE_URL="postgresql://resourcehive_app_login:password@pooled-host:5432/resourcehive?sslmode=require"
AUTH_DATABASE_URL="postgresql://resourcehive_auth_login:password@pooled-host:5432/resourcehive?sslmode=require"
WORKER_DATABASE_URL="postgresql://resourcehive_worker_login:password@pooled-host:5432/resourcehive?sslmode=require"
PLATFORM_REPORT_DATABASE_URL="postgresql://resourcehive_platform_login:password@pooled-host:5432/resourcehive?sslmode=require"
INTERNAL_SERVICE_TOKEN=replace_with_a_long_random_shared_service_token

# Authentication. Generate JWT_SECRET with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_production_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
AUTH_COOKIE_DOMAIN=.resourcehive.thisismalindu.com
AUTH_COOKIE_SECURE=true

# Vercel application origin and links used in verification/reset emails.
CORS_ORIGINS=https://app.resourcehive.thisismalindu.com
APP_URL=https://app.resourcehive.thisismalindu.com
# Set true only after the exact HTTPS callback URL is registered in Google Cloud.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://api.resourcehive.thisismalindu.com/auth/google/callback
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=24h
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# Shared Kafka transport for notification producers and Notification Service.
# Enable it before starting the production email flow.
DELIVERY_POLL_INTERVAL_MS=5000
KAFKA_ENABLED=true
KAFKA_BROKERS=kafka.example.com:9093
# Consumer-only settings. Producer client IDs are derived from service names.
KAFKA_CLIENT_ID=notification-service
KAFKA_CONSUMER_GROUP=notification-service-v1
KAFKA_SSL=true
KAFKA_SASL_USERNAME=replace_with_managed_kafka_username
KAFKA_SASL_PASSWORD=replace_with_managed_kafka_password

# Resend email provider. Verify RESEND_FROM_EMAIL's domain before deployment.
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM_EMAIL=ResourceHive <notifications@example.com>

# Resource and profile image uploads through Cloudinary.
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# Firebase Admin credentials are installed from the protected GitHub production
# environment secret FIREBASE_SERVICE_ACCOUNT_JSON and mounted read-only by
# Docker Compose. Do not put the JSON or a host file path in this env file.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
WEB_APP_URL=
