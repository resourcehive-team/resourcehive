# Public browser URL of the Caddy API gateway.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only secret used by the Next.js proxy to validate the access-token cookie.
# In production, set this in Vercel to the same value as the backend JWT_SECRET.
JWT_SECRET=replace_with_the_same_secret_used_by_the_identity_service

# Public Firebase Web App configuration from Firebase Project Settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=resourcehive-96c6f
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public key from Firebase Cloud Messaging > Web Push certificates.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
