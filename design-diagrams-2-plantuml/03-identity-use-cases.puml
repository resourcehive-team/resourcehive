@startuml
title Figure 3. Identity and Tenant Onboarding Use Cases
left to right direction
skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowFontSize 12
skinparam nodesep 55
skinparam ranksep 65
actor Visitor
actor "Unverified User" as Unverified
actor Member
actor "Platform Administrator" as PA
actor "OAuth Provider" as OAuth
rectangle ResourceHive {
  usecase "Register with institutional email" as UC1
  usecase "Verify email" as UC2
  usecase "Log in" as UC3
  usecase "Recover password" as UC4
  usecase "Refresh session" as UC5
  usecase "Link OAuth account" as UC6
  usecase "Create root tenant" as UC7
  usecase "Assign initial administrator" as UC8
  usecase "Suspend tenant or user" as UC9
}
Visitor --> UC1
Unverified --> UC2
Member --> UC3
Member --> UC4
Member --> UC5
Member --> UC6
OAuth --> UC6
PA --> UC7
PA --> UC8
PA --> UC9
UC1 .> UC2 : <<include>>
UC7 .> UC8 : <<include>>
@enduml


