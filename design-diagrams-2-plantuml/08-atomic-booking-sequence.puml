@startuml
title Figure 12. Atomic Booking and Point Deduction
skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowFontSize 12
skinparam nodesep 55
skinparam ranksep 65
actor Member
boundary "Next.js Booking UI" as UI
control "Nginx Gateway" as GW
control "BookingsController" as C
control "JWT/Tenant Guard" as G
control "BookingValidationService" as V
control "BookingCreationService" as S
control "BookingRepository" as BR
control "PointLedgerRepository" as PR
database PostgreSQL as DB
Member -> UI : Confirm selected slot
UI -> GW : POST /bookings
GW -> C : Route request
C -> G : Validate JWT and tenant scope
G -> V : Validate member, resource access, slot
V -> DB : Read membership/resource/slot
C -> S : createBooking(user, slot)
S -> DB : BEGIN; lock required records
S -> PR : calculateBalance(user)
PR -> DB : Sum append-only ledger
alt Eligible and sufficient points
  S -> BR : insert booking
  BR -> DB : Enforce one active booking per slot
  S -> PR : insert negative BOOKING transaction
  PR -> DB : Enforce unique booking deduction
  S -> DB : COMMIT
  S --> UI : Booking confirmed
else Conflict or insufficient points
  S -> DB : ROLLBACK
  S --> UI : Conflict or validation error
end
@enduml



