@startuml
title Figure 13. Booking Cancellation and Refund
skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowFontSize 12
skinparam nodesep 55
skinparam ranksep 65
actor Member
boundary "Next.js Booking UI" as UI
control "BookingsController" as C
control "BookingService" as S
control "AuthorizationService" as A
control "PointLedgerService" as P
control "NotificationService" as N
database PostgreSQL as DB
Member -> UI : Request cancellation with reason
UI -> C : DELETE/PATCH booking
C -> A : Confirm owner, tenant, cancellable state
A -> DB : Read booking and preserved policy
C -> S : cancelBooking(...)
S -> DB : BEGIN; lock booking
S -> S : Evaluate cancellation deadline
alt Refund permitted
  S -> DB : Mark CANCELLED and audit actor/reason
  S -> P : Add unique BOOKING_REFUND entry
  P -> DB : Insert append-only transaction
else Refund not permitted
  S -> DB : Mark CANCELLED without refund\nor reject according to policy
end
S -> DB : COMMIT
S -> N : Create cancellation notification
N -> DB : Persist recipient notification
S --> UI : Cancellation result
@enduml



