@startuml
title Figure 15. Membership Lifecycle Activity
skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowFontSize 12
skinparam nodesep 55
skinparam ranksep 65
start
:User registers and verifies institutional email;
if (Domain auto-join enabled\nor email allowlisted?) then (yes)
  :Create approved membership;
  :Award unique joining bonus;
else (no)
  :User discovers organizations in tenant;
  :Submit membership request;
  :Create PENDING membership;
  :Notify organization administrator;
  if (Administrator approves?) then (yes)
    :Set membership APPROVED;
    :Award joining bonus once;
  else (no)
    :Set membership REJECTED;
  endif
endif
:Notify user of outcome;
stop
@enduml



