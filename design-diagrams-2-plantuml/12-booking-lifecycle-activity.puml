@startuml
title Figure 16. Booking Lifecycle Activity
skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowFontSize 12
skinparam nodesep 55
skinparam ranksep 65
start
:Discover tenant-permitted resource;
:Select available slot;
:Validate membership, access, status, and points;
if (Valid and available?) then (yes)
  :Atomically create CONFIRMED booking\nand negative ledger entry;
  :Notify member/resource manager;
  if (Cancelled?) then (yes)
    :Validate cancellation policy;
    :Set CANCELLED;
    if (Refund eligible?) then (yes)
      :Append unique refund transaction;
    endif
  else (no)
    :Resource is used and returned;
    :Authorized manager marks COMPLETED;
    fork
      :Member may submit one rating;
    fork again
      :Member may open one dispute;
    end fork
  endif
else (no)
  :Return conflict, access, or balance error;
endif
stop
@enduml



