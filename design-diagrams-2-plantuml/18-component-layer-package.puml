@startuml
title Figure 19. Implementation Components, Layers, and Packages
skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowFontSize 12
skinparam nodesep 55
skinparam ranksep 65
package "apps/web" {
  component "Pages and Components" as Pages
  component "API Client" as Client
}
package "services/api-gateway" {
  component "Nginx Routes" as Nginx
}
package "NestJS Services" {
  component Controllers
  component "Application Services" as App
  component "Guards / Authorization" as Guards
  component Repositories
}
package "packages/service-auth" {
  component "JWT Guard and Claims" as SharedAuth
}
package "packages/database" {
  component "PrismaService and Generated Client" as Prisma
}
package "db/schema" {
  component "Prisma Schema and SQL Migrations" as Schema
}
database PostgreSQL
Pages --> Client
Client --> Nginx
Nginx --> Controllers
Controllers --> Guards
Guards ..> SharedAuth
Controllers --> App
App --> Repositories
Repositories --> Prisma
Prisma --> PostgreSQL
Schema ..> Prisma : generates/migrates
@enduml



