@startuml
title Figure 18. Initial Production Deployment
skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowFontSize 12
skinparam nodesep 55
skinparam ranksep 65
node "User Device" {
  artifact "Modern Browser" as Browser
}
cloud "DNS / HTTPS" as DNS
node "Frontend Hosting\n(Vercel or approved provider)" {
  artifact "Next.js Application" as Web
}
node "Backend Host\n(AWS EC2 or approved Docker host)" {
  node "Docker Compose Network" {
    node "Nginx Container" as GW
    node "Identity Container" as I
    node "Resource Container" as R
    node "Booking Container" as B
    node "Notification Container" as N
  }
}
cloud "PostgreSQL Provider\n(Neon or compatible)" as PG
cloud "SMTP Provider" as SMTP
Browser --> DNS : HTTPS
DNS --> Web
Web --> GW : HTTPS API
GW --> I : private Docker DNS
GW --> R : private Docker DNS
GW --> B : private Docker DNS
GW --> N : private Docker DNS
I --> PG : TLS SQL
R --> PG : TLS SQL
B --> PG : TLS SQL
N --> PG : TLS SQL
I --> SMTP : TLS SMTP/API
N --> SMTP : TLS SMTP/API
@enduml



