@startuml
title Figure 21. Database Integrity and Concurrency Controls
skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowFontSize 12
skinparam nodesep 55
skinparam ranksep 65
rectangle "Application Transaction" {
  component "Validate tenant, membership, access" as V
  component "Lock booking/slot/ledger records" as L
  component "Write domain records" as W
}
database PostgreSQL {
  component "Composite tenant keys" as TK
  component "Slot exclusion constraint" as EX
  component "One active booking per slot" as UB
  component "Unique point event indexes" as UP
  component "Append-only triggers" as AO
  component "Cross-table validation triggers" as CT
  component "Check constraints" as CC
}
V --> L
L --> W
W --> TK
W --> EX
W --> UB
W --> UP
W --> AO
W --> CT
W --> CC
note right of UP
Prevents duplicate join bonuses,
booking deductions, refunds,
and semester allocations.
end note
note right of CT
Validates hierarchy, semesters,
ratings, and tenant relationships.
end note
@enduml

