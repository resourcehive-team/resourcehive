@startuml
left to right direction

skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam ArrowFontSize 14
skinparam shadowing false

actor "Public Visitor" as Visitor
actor "Approved Member" as Member
actor "OAuth Provider" as OAuth
actor "Unverified User" as Unverified
actor "Platform Admin" as Admin

rectangle "ResourceHive" {
  usecase "Sign up with\ninstitutional email" as Register
  usecase "Log in" as Login
  usecase "Recover password" as Recover
  usecase "Refresh session" as Refresh
  usecase "Log out" as Logout
  usecase "Link OAuth account" as LinkOAuth
  usecase "Verify email" as Verify
  usecase "Assign initial\nadministrator" as AssignAdmin
  usecase "Create root tenant" as CreateTenant
  usecase "Suspend tenant or user" as Suspend

  Register -[hidden]down- Verify
  Recover -[hidden]down- AssignAdmin
}

Visitor --> Register

Member --> Login
Member --> Recover
Member --> Refresh
Member --> Logout
Member --> LinkOAuth

OAuth --> LinkOAuth

Verify <-- Unverified

AssignAdmin <-- Admin
CreateTenant <-- Admin
Suspend <-- Admin
@enduml
