@startuml
title Figure 7. Resource, Booking, Points, and Semester Domain Classes

skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam ArrowFontSize 14
skinparam TitleFontSize 18
skinparam shadowing false

class Organization
class User

class Resource {
  pointCost: integer
  cancellationPeriodMinutes: integer
  rootOrganizationId: UUID
}

class ResourceAllowedOrganization {
  rootOrganizationId: UUID
}

class ResourceSlot {
  startsAt: timestamp
  endsAt: timestamp
}

class Booking {
  status: string
  cancelledAt: timestamp?
  completedAt: timestamp?
}

class PointTransaction {
  amount: integer
  transactionType: string
}

class Semester {
  academicYear: string
  semester: string
  startsAt: timestamp
  endsAt: timestamp
}

Organization "1 owner" -- "0..*" Resource
