{
  "name": "@resourcehive/database",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm run generate && tsc -p tsconfig.json && node -e \"const fs=require('fs'); fs.cpSync('generated/client', 'dist/generated/client', {recursive: true});\"",
    "generate": "dotenv -e ../../.env -- prisma generate --schema ../../db/schema/schema.prisma",
    "init": "pnpm run migrate:deploy && pnpm run build",
    "db:push": "dotenv -e ../../.env -- prisma db push --schema ../../db/schema/schema.prisma",
    "migrate": "pnpm run migrate:deploy",
    "migrate:reset": "dotenv -e ../../.env -- prisma migrate reset --force --schema ../../db/schema/schema.prisma",
    "migrate:create": "dotenv -e ../../.env -- prisma migrate dev --create-only --schema ../../db/schema/schema.prisma",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema ../../db/schema/schema.prisma",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev --schema ../../db/schema/schema.prisma",
    "migrate:status": "dotenv -e ../../.env -- prisma migrate status --schema ../../db/schema/schema.prisma",
    "test:rls": "dotenv -e ../../.env -- node ../../db/schema/tests/rls-test.cjs",
    "studio": "dotenv -e ../../.env -- prisma studio --schema ../../db/schema/schema.prisma",
    "validate": "dotenv -e ../../.env -- prisma validate --schema ../../db/schema/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@prisma/client": "^5.22.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "dotenv-cli": "^7.3.0",
    "prisma": "^5.22.0",
    "typescript": "^5.0.0"
  }
}
