{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "declarationDir": "./dist",
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["index.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
