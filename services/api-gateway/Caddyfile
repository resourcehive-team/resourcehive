{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip

	@identity path /auth /auth/*
	@avatarUpload {
		method POST
		path /auth/me/avatar
	}
	@resourceSlots path_regexp resourceSlots ^/resources/[^/]+/slots/?$
	@resource path /organizations /organizations/* /memberships /memberships/* /resources /resources/*
	@booking path /slots /slots/* /bookings /bookings/* /points /points/* /disputes /disputes/* /analytics /analytics/*
	@notifications path /notifications /notifications/*

	@identityDocs path /docs/identity /docs/identity/*
	@resourceDocs path /docs/resource /docs/resource/*
	@bookingDocs path /docs/booking /docs/booking/*
	@notificationDocs path /docs/notification /docs/notification/*

	route {
		respond /health "ok" 200
		request_body @avatarUpload {
			max_size 6MiB
		}

		reverse_proxy @identityDocs identity-service:3000
		reverse_proxy @resourceDocs resource-service:3004
		reverse_proxy @bookingDocs booking-service:3002
		reverse_proxy @notificationDocs notification-service:3003

		reverse_proxy @identity identity-service:3000
		reverse_proxy @resourceSlots booking-service:3002
		reverse_proxy @resource resource-service:3004
		reverse_proxy @booking booking-service:3002
		reverse_proxy @notifications notification-service:3003

		respond "Not Found" 404
	}
}
