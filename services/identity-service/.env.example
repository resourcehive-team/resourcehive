PORT=3001
DATABASE_URL=postgresql://user:password@host:5432/resourcehive
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/resourcehive
JWT_SECRET=replace_with_a_long_random_secret
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Leave AUTH_COOKIE_DOMAIN empty for localhost.
# In production, use the shared parent domain, for example .resourcehive.com.
AUTH_COOKIE_DOMAIN=
# Leave empty to use false locally and true automatically in production.
AUTH_COOKIE_SECURE=

BCRYPT_ROUNDS=12
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=24h

# Use console locally. The verification link is printed by Identity Service.
EMAIL_TRANSPORT=console
EMAIL_FROM=ResourceHive <no-reply@resourcehive.local>

# Required only when EMAIL_TRANSPORT=smtp.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
