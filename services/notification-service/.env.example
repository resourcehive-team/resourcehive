# Required PostgreSQL connection string. Secret: yes.
DATABASE_URL=postgresql://user:password@database:5432/resourcehive

# Required JWT signing secret shared with Identity Service. Secret: yes.
JWT_SECRET=replace_with_a_long_random_secret

# Optional, integration tests only. Must point to a disposable database.
TEST_DATABASE_URL=postgresql://user:password@database:5432/resourcehive_test

# Optional internal HTTP port. Secret: no.
PORT=3003

# Optional comma-separated browser origins. Secret: no.
CORS_ORIGINS=http://localhost:3000
