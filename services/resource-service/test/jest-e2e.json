{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.[tj]s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!.*(@nestjs/cache-manager|cache-manager|keyv))"
  ]
}